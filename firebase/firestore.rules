rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /User/{document} {
      allow create: if request.auth.uid == document;
      allow read: if true;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth != null;
    }

    match /Product/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if resource.data.seller_ref == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if request.auth != null;
    }

    match /Cart/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.user_ref == /databases/$(database)/documents/User/$(request.auth.uid);
      allow write: if resource.data.user_ref == /databases/$(database)/documents/User/$(request.auth.uid);
      allow delete: if request.auth != null;
    }

    match /Orders/{document} {
      allow create: if request.resource.data.user_ref == /databases/$(database)/documents/User/$(request.auth.uid);
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /OrderItems/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /system_logs/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if request.auth != null;
    }

    match /Paiement/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if request.auth != null;
    }
  }
}
